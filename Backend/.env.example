# Copiar a .env y completar. El archivo .env nunca se versiona.

# development | production | test
NODE_ENV=development
PORT=3000
# Origen del frontend autorizado por CORS
CORS_ORIGIN=http://localhost:5173

# Base de datos. Aún no se usan: se validan al agregar TypeORM.
# Por defecto, el Postgres local de docker-compose.yml (docker compose up -d).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario
POSTGRES_DB=si2_local
POSTGRES_SSL=false

# API keys de los módulos que consumen los endpoints de integración (reserva, liberación, etc.).
# Formato: modulo:clave,modulo:clave (clave de 16 caracteres o más, sin comas ni espacios).
# Cada módulo la envía como "Authorization: Bearer <clave>". Vacío = nadie puede llamarlos.
# Generar una clave: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTEGRACION_API_KEYS=
# Para la BD del profesor (Neon): host (con -pooler para la app, sin -pooler
# para DDL), usuario y contraseña del correo, POSTGRES_DB=si2_22026 y POSTGRES_SSL=true.

#Secreto compartido con rrhh para validar el jwt
# vacio -> ningun usuario puede autenticarse (401)
JWT_SECRET=

# Tokens de prueba (POST /api/v1/auth/dev-token) para el login de prueba del front.
# Solo con un JWT_SECRET local: con el secreto real de RRHH, cualquiera podría firmar tokens válidos para todo el ERP.
AUTH_DEV_TOKENS=false
