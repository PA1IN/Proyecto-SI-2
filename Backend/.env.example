# Copiar a .env y completar. El archivo .env nunca se versiona.

# development | production | test
NODE_ENV=development
PORT=3000

# Base de datos (Neon). Aún no se usan: se validan al agregar TypeORM.
# App: host con -pooler. DDL: el mismo host sin -pooler.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=si2
POSTGRES_SSL=true
