# Copiar a .env y completar. El archivo .env nunca se versiona.

# development | production | test
NODE_ENV=development
PORT=3000
# Origen del frontend autorizado por CORS
CORS_ORIGIN=http://localhost:5173

# Base de datos. Aún no se usan: se validan al agregar TypeORM.
# Por defecto, el Postgres local de docker-compose.yml (docker compose up -d).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=inventario
POSTGRES_PASSWORD=inventario
POSTGRES_DB=si2_local
POSTGRES_SSL=false
# Para la BD del profesor (Neon): host (con -pooler para la app, sin -pooler
# para DDL), usuario y contraseña del correo, POSTGRES_DB=si2_22026 y POSTGRES_SSL=true.
